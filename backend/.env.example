# このファイルを .env にコピーして値を設定する (.env は Git に入らない)

# Google Cloud Console > APIとサービス > 認証情報 で作成した OAuth クライアント (ウェブアプリケーション)
# 「承認済みのリダイレクト URI」に http://localhost:3000/callback を登録すること
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ログインセッション (Cookie) の署名に使う秘密の値。openssl rand -hex 32 などで作る
SESSION_SECRET=

# 省略時は http://localhost:3000 / http://localhost:5173
# BACKEND_URL=
# FRONTEND_URL=
